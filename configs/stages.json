{
  "hash_alg": "sha256",
  "_order": "environment -> code -> prereg -> data -> scores -> figures. Paths are relative to the repository root; the manifest holds no absolute path.",
  "_note_code": "code/*.py covers the runners and analytic-table generators of the four workflow-B families (exponent, occupancy, fusion, quotas) and the shared grid runner. Test files are listed by name on purpose: files owned by other documents of the repository (docs/THEORY.md and its tripwire test; tests/test_doc_numbers.py, which locks the numbers quoted in README.md, docs/THEORY.md and REPRODUCIBILITY.md) are not part of the computational chain and may change without breaking the seal.",
  "_note_replicated": "run_all.py writes regenerated outputs to output/replicated/ (full run) and output/smoke/ (CI); neither directory matches any glob below (tests/test_stages_disjoint.py). Only run_all.py --publish writes the sealed outputs.",
  "stages": [
    {"name": "environment", "kind": "file", "path": "env.json"},
    {"name": "code", "kind": "tree", "globs": [
      "code/*.py",
      "scripts/make_figures.py",
      "run_all.py",
      "make_provenance.py",
      "configs/stages.json",
      "tests/conftest.py",
      "tests/test_displacement.py",
      "tests/test_displacement_locks.py",
      "tests/test_displacement_locks2.py",
      "tests/test_estimates.py",
      "tests/test_case_figures.py",
      "tests/test_figure3.py",
      "tests/test_token_kat.py",
      "tests/test_token_kat_extra.py",
      "tests/test_run_grid.py",
      "tests/test_exponent.py",
      "tests/test_occupancy.py",
      "tests/test_fusion.py",
      "tests/test_quotas.py",
      "tests/test_paper_numbers.py",
      "tests/test_hygiene.py",
      "tests/test_stages_disjoint.py",
      "tests/test_failure_paths.py"
    ]},
    {"name": "prereg", "kind": "tree", "globs": [
      "data/prereg/01-displacement-replication.md",
      "data/prereg/02-token-kat-addendum.md",
      "data/prereg/03-token-kat-deviations.md",
      "data/prereg/04-token-kat-deviations-b.md",
      "data/prereg/kat_token_analytic_table.txt",
      "data/kat_token_grid.json",
      "data/prereg/05-exponent-addendum.md",
      "data/prereg/exponent_analytic_table.txt",
      "data/exponent_grid.json",
      "data/prereg/06-occupancy-addendum.md",
      "data/prereg/occupancy_analytic_table.txt",
      "data/occupancy_grid.json",
      "data/prereg/07-fusion-addendum.md",
      "data/prereg/fusion_analytic_table.txt",
      "data/fusion_grid.json",
      "data/prereg/08-quotas-addendum.md",
      "data/prereg/quotas_analytic_table.txt",
      "data/quotas_grid.json",
      "data/prereg/09-exponent-deviations.md",
      "data/prereg/10-occupancy-deviations.md",
      "data/prereg/11-fusion-deviations.md",
      "data/prereg/12-quotas-deviations.md",
      "data/prereg/13-token-kat-item5-note.md",
      "configs/estimates_inputs.json",
      "configs/adoption_counts.csv"
    ]},
    {"name": "data", "kind": "tree", "globs": [
      "output/replication/celulas.csv",
      "output/kat_token/celulas.csv",
      "output/exponent/celulas.csv",
      "output/occupancy/celulas.csv",
      "output/fusion/celulas.csv",
      "output/quotas/celulas.csv"
    ]},
    {"name": "scores", "kind": "tree", "globs": [
      "output/replication/resumo.json",
      "output/kat_token/resumo.json",
      "output/exponent/resumo.json",
      "output/occupancy/resumo.json",
      "output/fusion/resumo.json",
      "output/quotas/resumo.json",
      "output/estimativas.json",
      "output/tables/enlaces_allreduce.csv",
      "output/tables/fanout_cauda.csv",
      "output/results.json"
    ]},
    {"name": "figures", "kind": "tree", "globs": [
      "output/figures/fig1_adoption.png",
      "output/figures/fig2_architecture.png",
      "output/figures/fig3_replication.png",
      "output/figures/fig3_values.json"
    ]}
  ]
